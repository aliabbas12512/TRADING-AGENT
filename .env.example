# MetaTrader 5 account credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your-password
MT5_SERVER=YourBroker-Live
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading configuration
SYMBOL=XAUUSD
TIMEFRAME=M15
MAGIC_NUMBER=234000

# Risk management
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=1
SL_ATR_MULTIPLIER=2.0
TP_ATR_MULTIPLIER=3.0

# Strategy parameters
FAST_MA_PERIOD=20
SLOW_MA_PERIOD=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Loop interval in seconds between signal checks
POLL_INTERVAL_SECONDS=60

# If set > 0, once the normal MA+RSI signal has stayed HOLD, the agent falls
# back to a looser trend-only signal so it places at least this many trades
# per day. Higher risk than the default strategy — leave at 0 unless you
# have a specific reason to require a minimum trade count.
MIN_DAILY_TRADES=0

# Set to "true" only once you have verified behavior on a demo account
LIVE_TRADING_CONFIRMED=false
